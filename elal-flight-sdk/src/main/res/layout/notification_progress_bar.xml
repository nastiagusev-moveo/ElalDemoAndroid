<?xml version="1.0" encoding="utf-8"?>
<!--
    XML replica of Android 16 Notification.ProgressStyle.
    Android 16 features mirrored here:
      - 7 milestone Points (dot views)  → notif_dot_0 … notif_dot_6
      - 6 Segments between points       → notif_seg_0 … notif_seg_5
      - Green (#4CAF50) = completed     → notification_dot_active / notification_seg_active
      - Grey  (#9E9E9E) = pending        → notification_dot_inactive / notification_seg_inactive
      - setStyledByProgress(false)      → colors are set explicitly per-dot/per-segment, not derived from a single progress value
      - CATEGORY_TRANSPORT              → set on the NotificationCompat builder
      - setOngoing(true)                → set on the NotificationCompat builder
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Title: mirrors Notification.Builder.setContentTitle() -->
    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Content text: mirrors Notification.Builder.setContentText() -->
    <TextView
        android:id="@+id/notif_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!--
        Progress row: mirrors Notification.ProgressStyle
        Dots   = ProgressStyle.Point   (fixed 12×12dp circles)
        Spaces = ProgressStyle.Segment (weighted width, 4dp tall, rounded ends)
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/notif_dot_0"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/notification_dot_inactive" />

        <ImageView
            android:id="@+id/notif_seg_0"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_seg_inactive" />

        <ImageView
            android:id="@+id/notif_dot_1"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/notification_dot_inactive" />

        <ImageView
            android:id="@+id/notif_seg_1"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_seg_inactive" />

        <ImageView
            android:id="@+id/notif_dot_2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/notification_dot_inactive" />

        <ImageView
            android:id="@+id/notif_seg_2"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_seg_inactive" />

        <ImageView
            android:id="@+id/notif_dot_3"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/notification_dot_inactive" />

        <ImageView
            android:id="@+id/notif_seg_3"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_seg_inactive" />

        <ImageView
            android:id="@+id/notif_dot_4"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/notification_dot_inactive" />

        <ImageView
            android:id="@+id/notif_seg_4"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_seg_inactive" />

        <ImageView
            android:id="@+id/notif_dot_5"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/notification_dot_inactive" />

        <ImageView
            android:id="@+id/notif_seg_5"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_seg_inactive" />

        <ImageView
            android:id="@+id/notif_dot_6"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/notification_dot_inactive" />

    </LinearLayout>

</LinearLayout>

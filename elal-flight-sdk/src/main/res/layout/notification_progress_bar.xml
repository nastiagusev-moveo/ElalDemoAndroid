<?xml version="1.0" encoding="utf-8"?>
<!--
    !! Just For View !!
    !! Not Used Anywhere In The Project !!
    TODO: Can Be Deleted
    ______________________________________________________________________
    XML replica of Android 16 Notification.ProgressStyle.
    Android 16 features mirrored here:
      - 4 Segments (no Points)            → notif_seg_0 … notif_seg_3
      - Green (#4CAF50) = completed       → notification_seg_active
      - Grey  (#9E9E9E) = pending         → notification_seg_inactive
      - Step 1 CHECK_IN:                  nothing green
      - Step 2 BOARDING_SOON/BOARDING/LAST_CALL: seg0 green
      - Step 3 DEPARTED:                  seg0 + seg1 + seg2 green
      - Step 4 ARRIVAL:                   all 4 segments green
      - setStyledByProgress(false)        → colors set explicitly per-segment
      - CATEGORY_TRANSPORT                → set on the NotificationCompat builder
      - setOngoing(true)                  → set on the NotificationCompat builder
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Title: mirrors Notification.Builder.setContentTitle() -->
    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Content text: mirrors Notification.Builder.setContentText() -->
    <TextView
        android:id="@+id/notif_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!--
        Progress row: mirrors Notification.ProgressStyle (segments only, no points)
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/notif_seg_0"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_seg_inactive" />

        <ImageView
            android:id="@+id/notif_seg_1"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:background="@drawable/notification_seg_inactive" />

        <ImageView
            android:id="@+id/notif_seg_2"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:background="@drawable/notification_seg_inactive" />

        <ImageView
            android:id="@+id/notif_seg_3"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:background="@drawable/notification_seg_inactive" />

    </LinearLayout>

</LinearLayout>
